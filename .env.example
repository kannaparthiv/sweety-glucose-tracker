# Sweety Blood Glucose Tracker - Global Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=sweety_jwt_secret_dev_key_2026

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_db
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=sweety_db

# Zero-config Embedded PostgreSQL (PGlite) fallback
# Set to true to run fully embedded without installing PostgreSQL daemon
USE_PGLITE=false
PGLITE_DATA_DIR=./data/pglite

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
