# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=super_secret_sweety_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# Option 1: Full PostgreSQL connection string (Docker or local or cloud instance)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_db

# Option 2: Individual PostgreSQL credentials
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=sweety_db

# Option 3: Zero-config embedded PGlite (useful for instant testing without Postgres daemon)
# Set to 'true' to use in-process PGlite (stores data in .pglite directory or memory)
USE_PGLITE=false
PGLITE_DATA_DIR=./data/pglite
